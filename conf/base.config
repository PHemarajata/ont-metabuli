/*
    Base resource requests — modest by default so the pipeline runs on a laptop.
    Every process is capped by check_max() against params.max_* ceilings.
*/

process {

    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 2.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_low {
        cpus   = { check_max( 2     * task.attempt, 'cpus'   ) }
        memory = { check_max( 3.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }

    withLabel: process_medium {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }

    // Metabuli: memory driven by --max-ram (+ headroom); cpus modest.
    withLabel: process_metabuli {
        cpus   = { check_max( 6, 'cpus' ) }
        memory = { check_max( ((params.metabuli_max_ram as int) + 2) + '.GB' as nextflow.util.MemoryUnit, 'memory' ) }
        time   = { check_max( 12.h * task.attempt, 'time' ) }
    }

    // Assembly (Flye/polish): modest — bins are small; Flye is memory-efficient.
    withLabel: process_assembly {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 12.h  * task.attempt, 'time'   ) }
        // an unassemblable bin is normal, not a pipeline failure
        errorStrategy = 'ignore'
    }
}

/*
    Minimal test profile — wires the DAG with tiny placeholder inputs.
    Intended for `-stub-run` (no real tools/DB needed) to validate plumbing:

        nextflow run . -profile test -stub-run --outdir test_out

    For a real end-to-end smoke test, override --metabuli_db and --host_fasta
    with real (small) paths, e.g. RefSeq_virus DB.
*/

params {
    input             = "${projectDir}/assets/samplesheet_test.csv"

    // placeholders — only used as path tokens under -stub-run
    host_fasta        = "${projectDir}/assets/stub_host.fa"
    metabuli_db       = "${projectDir}/assets/stub_db"

    metabuli_max_ram  = 4
    max_cpus          = 2
    max_memory        = '6.GB'
    max_time          = '2.h'

    stats_min_reads   = 1
    sankey_min_reads  = 1
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ont-metabuli  —  low-resource ONT metagenomics with Metabuli
    Nextflow config / params / profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'ont-metabuli'
    author          = 'built with Claude Code'
    description     = 'Low-resource Oxford Nanopore metagenomics: QC -> host removal -> Metabuli -> decontam stats -> Sankey'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    // ---- I/O ----
    input               = null                 // samplesheet CSV (sample,fastq,[fastq_2,]sample_type,batch)
    outdir              = 'results'

    // ---- sequencing platform ----
    // 'ont'      : long reads  -> chopper QC, minimap2 map-ont, Metabuli --seq-mode 3, Flye
    // 'illumina' : paired-end  -> fastp QC,   minimap2 sr,      Metabuli --seq-mode 2, MEGAHIT/SPAdes
    // Set per RUN, not per sample: the statistics compare samples against each
    // other, and ONT vs Illumina differ enough in bias/depth that mixing them in
    // one significance test would be confounded. Run each platform separately.
    platform            = 'ont'

    // ---- QC: long read (chopper) ----
    min_qual            = 10                    // min mean read quality (Q)
    min_len             = 500                   // min read length (bp)
    skip_qc             = false

    // ---- QC: short read (fastp) ----
    sr_min_qual         = 15                    // per-base quality threshold
    sr_min_len          = 50                    // min read length after trimming
    adapter_fasta       = null                  // optional adapter FASTA (fastp auto-detects otherwise)
    fastp_extra         = ''

    // ---- Host removal (minimap2 map-ont) ----
    host                = 'human'               // 'human' | 'none'  (label only, doc/reporting)
    host_fasta          = null                  // path to host FASTA (.fa/.fa.gz) OR prebuilt .mmi
    skip_host_removal   = false
    minimap2_index_size = '8G'                  // minimap2 -I : ref bases loaded per batch (mem knob)

    // ---- Metabuli classify ----
    metabuli_db         = null                  // path to Metabuli DB directory
    metabuli_max_ram    = 10                    // GiB; --max-ram (keep < physical RAM)
    metabuli_seq_mode   = null                  // auto from platform: ont->3, illumina->2
    metabuli_min_score  = 0                     // --min-score (0 = tool default)
    metabuli_precise    = true                  // --precise 1 (short-read preset) when platform=illumina
    metabuli_extra      = ''                    // any extra metabuli flags

    // ---- Decontamination / significance statistics ----
    stats_rank          = 'species'             // rank to test: species | genus
    stats_min_reads     = 10                    // min taxon reads to consider "detected"
    stats_min_abundance = 0.0001                // min relative abundance (fraction of classified)
    stats_alpha         = 0.05                  // BH-adjusted significance threshold
    stats_min_fold      = 5.0                   // min sample/control fold-enrichment (NC mode)
    stats_bg_rate       = 0.00001               // background contamination rate (no-NC Poisson test)
    control_types       = 'control,negative_control,ntc,blank,neg'  // sample_type values = neg. control

    // ---- Visualisation (Sankey) ----
    sankey_ranks        = 'D,P,C,O,F,G,S'       // ranks shown as Sankey columns
    sankey_top_n        = 15                    // top taxa per rank kept (readability)
    sankey_min_reads    = 5                     // min clade reads for a node to appear

    // ---- Optional assembly on binned reads (all OFF by default) ----
    assemble_unclassified = false               // A: de novo Flye on unclassified reads (novelty)
    assemble_taxa         = null                // B: 'taxid,taxid' or 'significant' -> de novo per taxon
    reference_consensus   = null                // C: 'taxid:/path/ref.fa;taxid2:/path/ref2.fa'
    classify_contigs      = false               // re-run Metabuli on contigs to name them (rescans DB)
    assembler             = null                // auto from platform: ont->flye, illumina->megahit
                                                // override with 'megahit' or 'spades' (metaSPAdes)
    polisher              = 'racon'             // racon | medaka | none  (long-read only)
    medaka_env            = null                // path to a separate medaka conda env (if polisher=medaka)
    medaka_model          = null                // medaka model, e.g. r1041_e82_400bps_sup_v5.0.0
    flye_read_type        = 'nano-hq'           // nano-hq | nano-raw | nano-corr
    min_bin_reads         = 50                  // skip assembly of bins smaller than this
    min_contig_len        = 500                 // short-read assemblers: drop contigs below this

    // ---- Resource ceilings (defaults tuned for a 16 GB Mac) ----
    max_cpus            = 8
    max_memory          = '12.GB'
    max_time            = '24.h'

    // ---- misc ----
    publish_dir_mode    = 'copy'
    help                = false
    tracedir            = "${params.outdir}/pipeline_info"
}

// ---------------------------------------------------------------------------
//  Profiles
// ---------------------------------------------------------------------------
profiles {

    // Recommended on Apple Silicon: tools come from PATH (native mamba env +
    // native Metabuli universal binary). See setup.sh / README.
    standard {
        process.conda     = null
        docker.enabled    = false
        singularity.enabled = false
    }

    // Nextflow-managed conda env per process (portable; slower first run).
    conda {
        conda.enabled     = true
        conda.channels    = ['conda-forge', 'bioconda']
        docker.enabled    = false
        // NB: Metabuli in bioconda is x86 only; on Apple Silicon prefer 'standard'
        //     with the native universal binary. See README "Metabuli on ARM".
    }

    // Docker (portable / reproducible). On Apple Silicon images run under
    // emulation (linux/amd64) — correct but slower than 'standard'.
    docker {
        docker.enabled    = true
        docker.runOptions = '--platform=linux/amd64'
        conda.enabled     = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }

    test { includeConfig 'conf/test.config' }
}

// ---------------------------------------------------------------------------
//  Base resources (labels) + capping helper
// ---------------------------------------------------------------------------
includeConfig 'conf/base.config'

// ---------------------------------------------------------------------------
//  Reporting
// ---------------------------------------------------------------------------
def trace_ts = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())
timeline { enabled = true; file = "${params.tracedir}/timeline_${trace_ts}.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report_${trace_ts}.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace_${trace_ts}.txt";     overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/dag_${trace_ts}.html";      overwrite = true }

// ---------------------------------------------------------------------------
//  check_max — cap requested resources at the ceilings above (nf-core idiom)
// ---------------------------------------------------------------------------
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { println "   ### ERROR ### max_memory '${params.max_memory}' invalid! Using default: $obj"; return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { println "   ### ERROR ### max_time '${params.max_time}' invalid! Using default: $obj"; return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) { println "   ### ERROR ### max_cpus '${params.max_cpus}' invalid! Using default: $obj"; return obj }
    }
}
